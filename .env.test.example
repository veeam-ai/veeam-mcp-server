# Environment variables for E2E tests
# Copy this file to .env.test and fill in the actual values

PRODUCT_NAME=                   # One of - vbr,vspc,vone
WEB_URL=                        # URL of product web interface
ADMIN_USERNAME=administrator    # Admin username
ADMIN_PASSWORD=123qweASD        # Admin password
ACCEPT_SELF_SIGNED_CERT=true    # Accept self-signed certificates
NODE_TLS_REJECT_UNAUTHORIZED=0  # Disable TLS certificate validation (set to 0 for development/test environments)