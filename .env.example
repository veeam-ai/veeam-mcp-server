# Copy this file to .env and fill in the actual values

PRODUCT_NAME=                       # One of: vbr,vspc,vone
WEB_URL=                            # URL of product web interface
ADMIN_USERNAME=                     # Admin username
ADMIN_PASSWORD=                     # Admin password
ACCEPT_SELF_SIGNED_CERT=            # Accept self-signed certificates [true/false]
ACTION_CONFIRMATION_TIMEOUT_SEC=    # Optional. Seconds to wait for the user decision on an action before declining it (default 1500)
CHAT_TURN_TIMEOUT_SEC=              # Optional. Upper bound in seconds for one Veeam Intelligence answer (default 3600)
