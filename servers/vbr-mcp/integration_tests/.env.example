# Copy this file to .env and fill in the values. .env is git-ignored.

# ========== LLM (Azure OpenAI) ==========
# Azure OpenAI resource endpoint.
AZURE_ENDPOINT=
# Deployment name in the Azure resource, not the OpenAI model name.
AZURE_DEPLOYMENT=
AZURE_API_VERSION=
# Azure AD service principal with access to the Azure OpenAI resource.
# The tenant ID is the GUID at the end of AZURE_AUTHORITY (https://login.microsoftonline.com/<tenant-id>).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ========== Eval ==========
# Runs per case.
EVAL_REPEAT=3
# Parallel runs (default 4). Too many at once exceed the deployment's token rate limit.
# EVAL_MAX_CONCURRENCY=4
# Retries of a rate-limited (429) or failed LLM request, with exponential backoff (default 8).
# LLM_MAX_RETRIES=8
# Deployment for the LLM judges (default: AZURE_DEPLOYMENT). A judge of another model family is less lenient.
# JUDGE_DEPLOYMENT=
# Share of soft assertions (facts, judges, trajectory checks) a run must pass (default 0.9).
# MIN_SOFT_PASS_RATE=0.9
