# Copy this file to .env.test to pin the settings the test suite runs against.
#
# The suite mocks the VBR REST API at the transport layer, so no reachable VBR server
# is needed. This file exists to keep a real .env out of the test run: pytest points
# ENV_FILE_OVERRIDE at .env.test, and without it the tests fall back to the defaults in
# src/vbr_mcp/settings.py. Create it if your shell exports VBR_* or MCP_* globally.

VBR_BASE_URL=https://vbr.example.com:9419   # Never contacted - every request is mocked
VBR_USERNAME=test                           # Placeholder, never sent anywhere
VBR_PASSWORD=test                           # Placeholder, never sent anywhere
VBR_VERIFY_TLS=True
MCP_ENABLED=False                           # The in-process test client needs no bearer token
MCP_TOKENS={}
