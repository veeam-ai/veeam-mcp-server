# Copy this file to .env and fill in the actual values

PRODUCT_NAME=                       # One of: vbr,vspc,vone
WEB_URL=                            # URL of product web interface
ADMIN_USERNAME=                     # Admin username (stdio only; leave empty with MCP_TRANSPORT=http)
ADMIN_PASSWORD=                     # Admin password (stdio only; leave empty with MCP_TRANSPORT=http)
ACCEPT_SELF_SIGNED_CERT=            # Accept self-signed certificates [true/false]
ACTION_CONFIRMATION_TIMEOUT_SEC=    # Optional. Seconds to wait for the user decision on an action before declining it (default 1500)
CHAT_TURN_TIMEOUT_SEC=              # Optional. Upper bound in seconds for one Veeam Intelligence answer (default 3600)

MCP_TRANSPORT=                      # Optional. stdio (default) or http
MCP_HTTP_HOST=                      # Optional. Interface for the HTTP endpoint (default 127.0.0.1)
MCP_HTTP_PORT=                      # Optional. Port for the HTTP endpoint (default 8080)
MCP_HTTP_AUTH=                      # Optional. How HTTP users sign in: basic (default, password in every request) or oauth (sign-in page)
MCP_HTTP_PUBLIC_URL=                # OAuth only. Origin clients use, e.g. https://mcp.company.local:8080. Required unless MCP_HTTP_HOST is loopback
MCP_HTTP_TOKEN_SECRET=              # OAuth only. Min 32 chars (openssl rand -hex 32). Without it sign-ins end on restart
MCP_HTTP_SIGN_IN_MAX_AGE_SEC=       # OAuth only. Seconds before the user must enter the password again (default 43200)
MCP_HTTP_ALLOWED_REDIRECT_URIS=     # OAuth only. Comma-separated redirect URIs accepted besides loopback, e.g. https://vscode.dev/redirect
MCP_HTTP_BEHIND_TLS_PROXY=          # Optional. true when a reverse proxy terminates TLS. Off loopback, TLS (this or the cert/key below) is required
MCP_HTTP_TRUST_PROXY=               # Optional. Number of reverse proxies in front of the server, for the login rate limit (default 1 behind a TLS proxy, else 0)
MCP_HTTP_ALLOWED_HOSTS=             # Optional. Comma-separated host names accepted in Host/Origin headers
MCP_HTTP_TLS_CERT_FILE=             # Optional. PEM certificate to serve HTTPS (set together with MCP_HTTP_TLS_KEY_FILE)
MCP_HTTP_TLS_KEY_FILE=              # Optional. PEM private key to serve HTTPS
MCP_HTTP_MAX_SESSIONS=              # Optional. Maximum concurrent HTTP sessions in total; one session per connected client window (default 1000)
MCP_HTTP_MAX_SESSIONS_PER_USER=     # Optional. Maximum concurrent HTTP sessions of one Veeam user (default 10)
MCP_HTTP_SESSION_IDLE_TIMEOUT_SEC=  # Optional. Close HTTP sessions idle this long (default 3600)
