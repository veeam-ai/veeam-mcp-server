{
    "name": "veeam-intelligence-mcp-server",
    "version": "1.0.0",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "prestart": "npm ci",
        "start": "node --env-file-if-exists=.env build/index.js",
        "build": "rm -rf build/ && node esbuild.config.js",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
        "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
        "test:e2e": "node --experimental-vm-modules --env-file-if-exists=.env.test node_modules/jest/bin/jest.js --config jest.e2e.config.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
        "format": "prettier --log-level warn --write \"src/**/*.{ts,js,json}\" ",
        "typecheck": "tsc --noEmit",
        "audit:security": "npm audit",
        "audit:deps": "depcheck",
        "audit": "npm run audit:security && npm run audit:deps",
        "ci": "npm run format:check && npm run lint && npm run typecheck && echo \"\n✅ [PASSED]: All quality checks complete.\"",
        "ci:full": "npm run ci && npm test && npm run build && npm run audit && echo \"\n🚀 [PASSED]: Full CI complete.\"",
        "tidy": "npm run format && npm run lint:fix && npm run ci",
        "mcp_inspector": "node esbuild.config.js && npx @modelcontextprotocol/inspector node ./build/index.js"
    },
    "keywords": [
        "veeam",
        "mcp",
        "model-context-protocol",
        "veeam-intelligence",
        "veeam-one",
        "backup",
        "monitoring",
        "ai",
        "automation"
    ],
    "author": "Veeam",
    "license": "MIT",
    "description": "Veeam Intelligence MCP server that integrates with any MCP-compatible client (Claude Desktop, VS Code, etc.) for enhanced Veeam Backup & Replication, Veeam One, and VSPC monitoring and management capabilities",
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=10.0.0"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "axios": "^1.20.0",
        "rxjs": "7.8.2",
        "socket.io-client": "^4.8.3",
        "uuid": "^14.0.2",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@jest/globals": "^30.5.1",
        "@types/jest": "^30.0.0",
        "depcheck": "^1.4.7",
        "esbuild": "^0.28.2",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-license-header": "^0.9.0",
        "jest": "^30.5.1",
        "prettier": "^3.9.6",
        "socket.io": "^4.8.3",
        "ts-jest": "^29.4.12",
        "ts-node": "10.9.2",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.70.0"
    }
}
